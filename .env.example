# Obtain your own keys. Never share a populated .env.
ENHANCOR_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Required by Enhancor. Leave blank to use the automatic cloudflared callback tunnel.
ENHANCOR_WEBHOOK_URL=
# tmpfiles (temporary) or catbox (public persistent hosting)
MEDIA_HOST=tmpfiles
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=
# Private alternative: MEDIA_HOST=s3 uploads to your own bucket and sends presigned URLs.
# AWS credentials come from the normal AWS chain (env, profile or role). See ZEUG.md.
S3_MEDIA_BUCKET=
S3_MEDIA_PREFIX=genjutsu/
S3_MEDIA_EXPIRES=86400
S3_MEDIA_REGION=
# With MEDIA_HOST=s3, public fallbacks are ignored unless this is 1.
MEDIA_HOST_ALLOW_PUBLIC_FALLBACK=
# zeug/gj.py refuses billed stages without --allow-paid; 1 allows them for this environment.
GENJUTSU_ALLOW_PAID=
# Optional OpenAI-compatible vision model for zeug/gj.py review-assist --vision.
GENJUTSU_VISION_BASE_URL=
GENJUTSU_VISION_API_KEY=
GENJUTSU_VISION_MODEL=
